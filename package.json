{
  "name": "control-de-inventarios",
  "version": "1.4.8",
  "private": true,
  "scripts": {
    "start": "node tools/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i styles/input.css -o styles/utilities.css --minify",
    "build:cache": "node tools/build-cache.cjs",
    "build": "npm run build:css && npm run build:cache",
    "android:prepare": "npm run build && node tools/android-prepare.cjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2"
  }
}
